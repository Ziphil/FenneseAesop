\zml?|version="1.1"|;
\xml?|version="1.0",encoding="UTF-8"|;


\plain|id="inflection"|<
  \heading<付録: 語形変化表>

  \section|nobr|<
    \p<
      フェンナ語は語形変化によって文法的情報を表す言語ですが、紙面の関係上、本文では語形変化の具体的な形式についてほとんど触れられませんでした。
      その代わりに、この付録として語形変化表を掲載することにしました。
      いくつかの典型的な変化パターンをもった単語を例として挙げて、その単語の変化形を表の形でまとめてあります。
    >
    \p<
      フェンナ語には Claude AI 用の辞書データ参照スキルが用意されています。
      これには語形変化情報も埋め込まれているため、語形変化を調べるのにこのスキルを利用するのも 1 つの手です。
      以下のページからスキルファイルをダウンロードすることができます。
      具体的なインストール方法については、遷移先のページを参照してください。
    >
    \url<https:`/`/ziphil.com`/fennese`/database`/2.html>
    \p<
      このスキルをインストールした状態で、例えば「{соги̂ччев} は何という単語のどういう変化形ですか」と聞けば辞書形や変化の種類を教えてくれますし、「{ери̂ш} の全変化形を表にして」と頼めば変化表を作ってくれます。
      単語の注解を見ているときに何か疑問があったら、Claude に質問してみるのも良いでしょう。
    >
  >

  \section<
    \heading<名詞>
    \p<
      前半の {фи̂ллат} と {ти̂лго} が、それぞれ水類名詞と火類名詞の典型的な変化です。
      3 つ目の {соги̂тач} は子音の音便変化 ([тч] → [чч]) の例として、4 つ目の {и̂кто} は定を表す [ле‧]`/[ло‧] が語幹の母音と融合している例として挙げてあります。
    >
    \itable<
      \thead<
        \th;
        \th<\sh<{фи̂ллат}>\ja<「ウサギ」>>
        \th<\sh<{ти̂лго}>\ja<「脚」>>
        \th<\sh<{соги̂тач}>\ja<「ブドウ」>>
        \th<\sh<{и̂кто}>\ja<「真実」>>
      >
      \tr<\an;\an<水類>\an<火類>\an<水類>\an<火類>>
      \tr<\an<連用·主格·不定>\fm<{фи̂ллат}>\fm<{ти̂лго}>\fm<{соги̂тач}>\fm<{и̂кто}>>
      \tr<\an<連用·対格·不定>\fm<{фи̂ллата}>\fm<{ти̂лга}>\fm<{соги̂чча}>\fm<{и̂кта}>>
      \tr<\an<連用·与格·不定>\fm<{фи̂ллатес}>\fm<{ти̂лгос}>\fm<{соги̂ччес}>\fm<{и̂ктос}>>
      \tr<\an<連用·奪格·不定>\fm<{фи̂ллатезам}>\fm<{ти̂лгозам}>\fm<{соги̂ччезам}>\fm<{и̂ктозам}>>
      \tr<\an<連用·具格·不定>\fm<{фи̂ллатот}>\fm<{ти̂лгут}>\fm<{соги̂ччот}>\fm<{и̂ктут}>>
      \tr<\an<連用·処格·不定>\fm<{фи̂ллати}>\fm<{ти̂лге}>\fm<{соги̂ччи}>\fm<{и̂кте}>>
      \tr<\an<連体·主格·不定>\fm<{фи̂ллатев}>\fm<{ти̂лгов}>\fm<{соги̂ччев}>\fm<{и̂ктов}>>
      \tr<\an<連体·対格·不定>\fm<{фи̂ллатевах}>\fm<{ти̂лговах}>\fm<{соги̂ччевах}>\fm<{и̂ктовах}>>
      \tr<\an<連体·与格·不定>\fm<{фи̂ллатевас}>\fm<{ти̂лговас}>\fm<{соги̂ччевас}>\fm<{и̂ктовас}>>
      \tr<\an<連体·奪格·不定>\fm<{фи̂ллатевзам}>\fm<{ти̂лговзам}>\fm<{соги̂ччевзам}>\fm<{и̂ктовзам}>>
      \tr<\an<連体·具格·不定>\fm<{фи̂ллатевот}>\fm<{ти̂лговот}>\fm<{соги̂ччевот}>\fm<{и̂ктовот}>>
      \tr<\an<連体·処格·不定>\fm<{фи̂ллатеве}>\fm<{ти̂лгове}>\fm<{соги̂ччеве}>\fm<{и̂ктове}>>
      \tr<\an<連用·主格·定>\fm<{лефи̂ллат}>\fm<{лоти̂лго}>\fm<{лесги̂тач}>\fm<{ли̂кто}>>
      \tr<\an<連用·対格·定>\fm<{лефи̂ллата}>\fm<{лоти̂лга}>\fm<{лесги̂чча}>\fm<{ли̂кта}>>
      \tr<\an<連用·与格·定>\fm<{лефи̂ллатес}>\fm<{лоти̂лгос}>\fm<{лесги̂ччес}>\fm<{ли̂ктос}>>
      \tr<\an<連用·奪格·定>\fm<{лефи̂ллатезам}>\fm<{лоти̂лгозам}>\fm<{лесги̂ччезам}>\fm<{ли̂ктозам}>>
      \tr<\an<連用·具格·定>\fm<{лефи̂ллатот}>\fm<{лоти̂лгут}>\fm<{лесги̂ччот}>\fm<{ли̂ктут}>>
      \tr<\an<連用·処格·定>\fm<{лефи̂ллати}>\fm<{лоти̂лге}>\fm<{лесги̂ччи}>\fm<{ли̂кте}>>
      \tr<\an<連体·主格·定>\fm<{лефи̂ллатев}>\fm<{лоти̂лгов}>\fm<{лесги̂ччев}>\fm<{ли̂ктов}>>
      \tr<\an<連体·対格·定>\fm<{лефи̂ллатевах}>\fm<{лоти̂лговах}>\fm<{лесги̂ччевах}>\fm<{ли̂ктовах}>>
      \tr<\an<連体·与格·定>\fm<{лефи̂ллатевас}>\fm<{лоти̂лговас}>\fm<{лесги̂ччевас}>\fm<{ли̂ктовас}>>
      \tr<\an<連体·奪格·定>\fm<{лефи̂ллатевзам}>\fm<{лоти̂лговзам}>\fm<{лесги̂ччевзам}>\fm<{ли̂ктовзам}>>
      \tr<\an<連体·具格·定>\fm<{лефи̂ллатевот}>\fm<{лоти̂лговот}>\fm<{лесги̂ччевот}>\fm<{ли̂ктовот}>>
      \tr<\an<連体·処格·定>\fm<{лефи̂ллатеве}>\fm<{лоти̂лгове}>\fm<{лесги̂ччеве}>\fm<{ли̂ктове}>>
    >
  >

  \section<
    \heading<形容詞>
    \p<
      形容詞は、1 つの単語が水類形と火類形の両方をもつことを除けば、名詞と同じ変化をします。
      1 つ目の {фефу̂хат} が典型的な変化で、2 つ目の {веки̂ффо} は水類形が火類形のような変化をする特殊な例です。
    >
    \itable<
      \thead<
        \th;
        \th|col="2"|<\sh<{фефу̂хат}>\ja<「小高い」>>
        \th|col="2"|<\sh<{веки̂ффо}>\ja<「正直な」>>
      >
      \tr<\an;\an<水類>\an<火類>\an<水類>\an<火類>>
      \tr<\an<連用·主格·不定>\fm<{фефу̂хат}>\fm<{фефу̂хто}>\fm<{веки̂ффо}>\fm<{веки̂ффу}>>
      \tr<\an<連用·対格·不定>\fm<{фефу̂хта}>\fm<{фефу̂хта}>\fm<{веки̂ффо}>\fm<{веки̂ффо}>>
      \tr<\an<連用·与格·不定>\fm<{фефу̂хтес}>\fm<{фефу̂хтос}>\fm<{веки̂ффос}>\fm<{веки̂ффус}>>
      \tr<\an<連用·奪格·不定>\fm<{фефу̂хтезам}>\fm<{фефу̂хтозам}>\fm<{веки̂ффозам}>\fm<{веки̂ффузам}>>
      \tr<\an<連用·具格·不定>\fm<{фефу̂хтот}>\fm<{фефу̂хтут}>\fm<{веки̂ффут}>\fm<{веки̂ффут}>>
      \tr<\an<連用·処格·不定>\fm<{фефу̂хти}>\fm<{фефу̂хте}>\fm<{веки̂ффе}>\fm<{веки̂ффо}>>
      \tr<\an<連体·主格·不定>\fm<{фефу̂хтев}>\fm<{фефу̂хтов}>\fm<{веки̂ффов}>\fm<{веки̂ффув}>>
      \tr<\an<連体·対格·不定>\fm<{фефу̂хтевах}>\fm<{фефу̂хтовах}>\fm<{веки̂ффовах}>\fm<{веки̂ффувах}>>
      \tr<\an<連体·与格·不定>\fm<{фефу̂хтевас}>\fm<{фефу̂хтовас}>\fm<{веки̂ффовас}>\fm<{веки̂ффувас}>>
      \tr<\an<連体·奪格·不定>\fm<{фефу̂хтевзам}>\fm<{фефу̂хтовзам}>\fm<{веки̂ффовзам}>\fm<{веки̂ффувзам}>>
      \tr<\an<連体·具格·不定>\fm<{фефу̂хтевот}>\fm<{фефу̂хтовот}>\fm<{веки̂ффовот}>\fm<{веки̂ффувот}>>
      \tr<\an<連体·処格·不定>\fm<{фефу̂хтеве}>\fm<{фефу̂хтове}>\fm<{веки̂ффове}>\fm<{веки̂ффуве}>>
      \tr<\an<連用·主格·定>\fm<{леффу̂хат}>\fm<{лоффу̂хто}>\fm<{левки̂ффо}>\fm<{ловки̂ффу}>>
      \tr<\an<連用·対格·定>\fm<{леффу̂хта}>\fm<{лоффу̂хта}>\fm<{левки̂ффо}>\fm<{ловки̂ффо}>>
      \tr<\an<連用·与格·定>\fm<{леффу̂хтес}>\fm<{лоффу̂хтос}>\fm<{левки̂ффос}>\fm<{ловки̂ффус}>>
      \tr<\an<連用·奪格·定>\fm<{леффу̂хтезам}>\fm<{лоффу̂хтозам}>\fm<{левки̂ффозам}>\fm<{ловки̂ффузам}>>
      \tr<\an<連用·具格·定>\fm<{леффу̂хтот}>\fm<{лоффу̂хтут}>\fm<{левки̂ффут}>\fm<{ловки̂ффут}>>
      \tr<\an<連用·処格·定>\fm<{леффу̂хти}>\fm<{лоффу̂хте}>\fm<{левки̂ффе}>\fm<{ловки̂ффо}>>
      \tr<\an<連体·主格·定>\fm<{леффу̂хтев}>\fm<{лоффу̂хтов}>\fm<{левки̂ффов}>\fm<{ловки̂ффув}>>
      \tr<\an<連体·対格·定>\fm<{леффу̂хтевах}>\fm<{лоффу̂хтовах}>\fm<{левки̂ффовах}>\fm<{ловки̂ффувах}>>
      \tr<\an<連体·与格·定>\fm<{леффу̂хтевас}>\fm<{лоффу̂хтовас}>\fm<{левки̂ффовас}>\fm<{ловки̂ффувас}>>
      \tr<\an<連体·奪格·定>\fm<{леффу̂хтевзам}>\fm<{лоффу̂хтовзам}>\fm<{левки̂ффовзам}>\fm<{ловки̂ффувзам}>>
      \tr<\an<連体·具格·定>\fm<{леффу̂хтевот}>\fm<{лоффу̂хтовот}>\fm<{левки̂ффовот}>\fm<{ловки̂ффувот}>>
      \tr<\an<連体·処格·定>\fm<{леффу̂хтеве}>\fm<{лоффу̂хтове}>\fm<{левки̂ффове}>\fm<{ловки̂ффуве}>>
    >
  >
  
  \section<
    \heading<代名詞>
    \p<
      代名詞は、一般名詞と同様の変化をしますが、語形による定性の区別がありません。
      代わりに、人や物を表す代名詞は、形容詞のように水類形と火類形の両方をもちます。
    >
    \p<
      代名詞の中には、{ех} のように強勢をもたないものがあり、これは一般名詞とは若干異なる変化をします。
      また、このような代名詞は主格形をもっておらず、主格の意味では強勢をもつ別の代名詞で代用されます。
    >
    \itable<
      \thead<
        \th;
        \th|col="2"|<\sh<{и̂цце}>\ja<「私」>>
        \th|col="2"|<\sh<{ех}>\ja<「彼, 彼女, それ」>>
      >
      \tr<\an;\an<水類>\an<火類>\an<水類>\an<火類>>
      \tr<\an<連用·主格>\fm<{и̂цце}>\fm<{и̂ццо}>\fm<—>\fm<—>>
      \tr<\an<連用·対格>\fm<{и̂цца}>\fm<{и̂цца}>\fm<{ех}>\fm<{ох}>>
      \tr<\an<連用·与格>\fm<{и̂ццес}>\fm<{и̂ццос}>\fm<{ес}>\fm<{ос}>>
      \tr<\an<連用·奪格>\fm<{и̂ццезам}>\fm<{и̂ццозам}>\fm<{ем}>\fm<{ом}>>
      \tr<\an<連用·具格>\fm<{и̂ццот}>\fm<{и̂ццут}>\fm<{ет}>\fm<{от}>>
      \tr<\an<連用·処格>\fm<{и̂цци}>\fm<{и̂цце}>\fm<{и}>\fm<{е}>>
      \tr<\an<連体·主格>\fm<{и̂ццев}>\fm<{и̂ццов}>\fm<—>\fm<—>>
      \tr<\an<連体·対格>\fm<{и̂ццевах}>\fm<{и̂ццовах}>\fm<{евах}>\fm<{овах}>>
      \tr<\an<連体·与格>\fm<{и̂ццевас}>\fm<{и̂ццовас}>\fm<{евас}>\fm<{овас}>>
      \tr<\an<連体·奪格>\fm<{и̂ццевзам}>\fm<{и̂ццовзам}>\fm<{евам}>\fm<{овам}>>
      \tr<\an<連体·具格>\fm<{и̂ццевот}>\fm<{и̂ццовот}>\fm<{еват}>\fm<{оват}>>
      \tr<\an<連体·処格>\fm<{и̂ццеве}>\fm<{и̂ццове}>\fm<{еве}>\fm<{ове}>>
    >
  >

  \section|nobr|<
    \heading<前置形容詞>
    \p<
      形容詞の前置形は、類による変化しかありません。
      ほとんどは以下の {лу̂цзѐ} のような変化をしますが、{сечу̂ко̀} は語尾の母音が例外的です。
    >
    \itable<
      \thead<
        \th;
        \th|col="2"|<\sh<{лу̂цзѐ}>\ja<「全ての」>>
        \th|col="2"|<\sh<{сечу̂ко̀}>\ja<「それぞれの」>>
      >
      \tr<\an;\an<水類>\an<火類>\an<水類>\an<火類>>
      \tr<\an<前置>\fm<{лу̂цзѐ}>\fm<{лу̂цзо̀}>\fm<{сечу̂ко̀}>\fm<{сечу̂ку̀}>>
    >
  >


  \section<
    \heading<動詞 (通常)>
    \p<
      1 つ目の {заххи̂с} が典型的な変化です。
      2 つ目の {ери̂ш} は接頭辞が語幹の母音と融合する場合の例です。
    >
    \itable<
      \thead<
        \th;
        \th|col="2"|<\sh<{заххи̂с}>\ja<「到着する」>>
        \th|col="2"|<\sh<{ери̂ш}>\ja<「言う」>>
      >
      \tr<\an;\an<能動態·現在時制>\an<能動態·過去時制>\an<能動態·現在時制>\an<能動態·過去時制>>
      \tr<\an<三人称·定·水類>\fm<{заххи̂с}>\fm<{заххи̂сан}>\fm<{ери̂ш}>\fm<{ери̂шан}>>
      \tr<\an<三人称·定·火類>\fm<{заххи̂со}>\fm<{заххи̂сно}>\fm<{ери̂шо}>\fm<{ери̂шно}>>
      \tr<\an<三人称·不定·水類>\fm<{азаххи̂с}>\fm<{азаххи̂сан}>\fm<{ери̂ш}>\fm<{ери̂шан}>>
      \tr<\an<三人称·不定·火類>\fm<{азаххи̂со}>\fm<{азаххи̂сно}>\fm<{ери̂шо}>\fm<{ери̂шно}>>
      \tr<\an<二人称·水類>\fm<{тезаххи̂с}>\fm<{тезаххи̂сан}>\fm<{тири̂ш}>\fm<{тири̂шан}>>
      \tr<\an<二人称·火類>\fm<{тозаххи̂со}>\fm<{тозаххи̂сно}>\fm<{тери̂шо}>\fm<{тери̂шно}>>
      \tr<\an<一人称複数·水類>\fm<{бамезаххи̂с}>\fm<{бамезаххи̂сан}>\fm<{бамири̂ш}>\fm<{бамири̂шан}>>
      \tr<\an<一人称複数·火類>\fm<{бамозаххи̂со}>\fm<{бамозаххи̂сно}>\fm<{бамери̂шо}>\fm<{бамери̂шно}>>
      \tr<\an<一人称単数·水類>\fm<{изаххи̂с}>\fm<{изаххи̂сан}>\fm<{ири̂ш}>\fm<{ири̂шан}>>
      \tr<\an<一人称単数·火類>\fm<{езаххи̂со}>\fm<{езаххи̂сно}>\fm<{ири̂шо}>\fm<{ири̂шно}>>
      \tr|bd|<\an;\an<受動態·現在時制>\an<受動態·過去時制>\an<受動態·現在時制>\an<受動態·過去時制>>
      \tr<\an<三人称·定·水類>\fm<{до̀заххи̂с}>\fm<{до̀заххи̂сан}>\fm<{дѐри̂ш}>\fm<{дѐри̂шан}>>
      \tr<\an<三人称·定·火類>\fm<{до̀заххи̂со}>\fm<{до̀заххи̂сно}>\fm<{дѐри̂шо}>\fm<{дѐри̂шно}>>
      \tr<\an<三人称·不定·水類>\fm<{адо̀заххи̂с}>\fm<{адо̀заххи̂сан}>\fm<{адѐри̂ш}>\fm<{адѐри̂шан}>>
      \tr<\an<三人称·不定·火類>\fm<{адо̀заххи̂со}>\fm<{адо̀заххи̂сно}>\fm<{адѐри̂шо}>\fm<{адѐри̂шно}>>
      \tr<\an<二人称·水類>\fm<{тедо̀заххи̂с}>\fm<{тедо̀заххи̂сан}>\fm<{тедѐри̂ш}>\fm<{тедѐри̂шан}>>
      \tr<\an<二人称·火類>\fm<{тодо̀заххи̂со}>\fm<{тодо̀заххи̂сно}>\fm<{тодѐри̂шо}>\fm<{тодѐри̂шно}>>
      \tr<\an<一人称複数·水類>\fm<{бамедо̀заххи̂с}>\fm<{бамедо̀заххи̂сан}>\fm<{бамедѐри̂ш}>\fm<{бамедѐри̂шан}>>
      \tr<\an<一人称複数·火類>\fm<{бамодо̀заххи̂со}>\fm<{бамодо̀заххи̂сно}>\fm<{бамодѐри̂шо}>\fm<{бамодѐри̂шно}>>
      \tr<\an<一人称単数·水類>\fm<{идо̀заххи̂с}>\fm<{идо̀заххи̂сан}>\fm<{идѐри̂ш}>\fm<{идѐри̂шан}>>
      \tr<\an<一人称単数·火類>\fm<{едо̀заххи̂со}>\fm<{едо̀заххи̂сно}>\fm<{едѐри̂шо}>\fm<{едѐри̂шно}>>
    >
  >

  \section<
    \heading<動詞 (動形容詞)>
    \p<
      動形容詞は、態による変化が追加で存在する以外は形容詞と同様に (したがって名詞と同様に) 変化します。
      語幹に [‧р] が挿入されるのが特徴です。
      まずは、能動態の形のみ一覧します。
    >
    \itable<
      \thead<
        \th;
        \th|col="2"|<\sh<{заххи̂с}>\ja<「到着する」>>
        \th|col="2"|<\sh<{ери̂ш}>\ja<「言う」>>
      >
      \tr<\an;\an<動形容詞·能動態·水類>\an<動形容詞‧能動態·火類>\an<動形容詞·能動態·水類>\an<動形容詞‧能動態·火類>>
      \tr<\an<連用·主格·不定>\fm<{заххи̂сар}>\fm<{заххи̂сро}>\fm<{ери̂шар}>\fm<{ери̂шро}>>
