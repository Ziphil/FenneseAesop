\zml?|version="1.1"|;
\xml?|version="1.0",encoding="UTF-8"|;


\story|id="story-lying-shepherd"|<
  \title<
    \sh<Футтач коццемуак>
    \ja<嘘つきの少年>
  >
  
  \sentence<
    \gloss<
      \li<\sh<{Аффе̂дди}>\pr<アッフェーッディ>\ct<>\an<>\ja<>>
      \li<\sh<{ахху̂з}>\pr<アッフーズ>\ct<>\an<>\ja<>>
      \li<\sh<{фу̂ттач}>\pr<フーッタチ>\ct<>\an<>\ja<>>
      \li<\sh<{мешу̂фашшарецесу̂ӈак}>\pr<メシューファッシャレツェスーガク>\ct<>\an<>\ja<>>
      \li<\sh<{фу̂хти}>\pr<フーフティ>\ct<>\an<>\ja<>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<>>
      \li<\sh<{зери̂ш}>\pr<ゼリーシ>\ct<>\an<>\ja<>>
      \li<\sh<{ри̂ццалот}>\pr<リーッツァロト>\ct<>\an<>\ja<>>
      \li<\sh<{би̂зот}[.]>\pr<ビーゾト>\ct<>\an<>\ja<>>
    >
    \ja<
      あるところで、羊飼いの少年が高いところに立って何度も叫びました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Таффу̂зла}[!]>\pr<タッフーズラ>\ct<>\an<>\ja<>>
      \li<\sh<{Ло̂во}[!]>\pr<ローヴォ>\ct<>\an<>\ja<>>
    >
    \ja<
      助けて! 狼だ!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ду̂ве}>\pr<ドゥーウェ>\ct<>\an<>\ja<>>
      \li<\sh<{са}>\pr<サ>\ct<>\an<>\ja<>>
      \li<\sh<{лобоҕсо̂аш}>\pr<ロボグソーワシ>\ct<>\an<>\ja<>>
      \li<\sh<{часи̂вве}>\pr<チャスィーッヴェ>\ct<>\an<>\ja<>>
      \li<\sh<{ро}>\pr<ロ>\ct<>\an<>\ja<>>
      \li<\sh<{те̂ддес}[,]>\pr<テーッデス>\ct<>\an<>\ja<>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<>>
      \li<\sh<{чо̀к}>\pr<チョーク>\ct<>\an<>\ja<>>
      \li<\sh<{заби̂ҕҕе}>\pr<ザビーッゲ>\ct<>\an<>\ja<>>
      \li<\sh<{ӈа}>\pr<ガ>\ct<>\an<>\ja<>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<>\an<>\ja<>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチ>\ct<>\an<>\ja<>>
      \li<\sh<{ажж’}>\pr<アッジ>\ct<>\an<>\ja<>>
      \li<\sh<{ери̂шан}>\pr<エリーシャン>\ct<>\an<>\ja<>>
      \li<\sh<{и̂кта}>\pr<イークタ>\ct<>\an<>\ja<>>
      \li<\sh<{шу̂то̀ӈ}[.]>\pr<シュートーン>\ct<>\an<>\ja<>>
    >
    \ja<
      農家たちはそちらの方へ走っていきましたが、少年が本当のことを全く言っていなかったと分かっただけでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<>\an<>\ja<>>
      \li<\sh<{ассади̂ц}>\pr<アッサディーツ>\ct<>\an<>\ja<>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチ>\ct<>\an<>\ja<>>
      \li<\sh<{ри̂ццалот}>\pr<リーッツァロト>\ct<>\an<>\ja<>>
      \li<\sh<{би̂зот}[.]>\pr<ビーゾト>\ct<>\an<>\ja<>>
    >
    \ja<
      少年はそれを何度も繰り返しました。
    >
  >

    \sentence<
    \gloss<
      \li<\sh<{Сечу̂ко̀}>\pr<セチューコー>\ct<>\an<>\ja<>>
      \li<\sh<{лоду̂сре}>\pr<ロドゥースレ>\ct<>\an<>\ja<>>
      \li<\sh<{вешти̂ез}>\pr<ベシティーイェズ>\ct<>\an<>\ja<>>
      \li<\sh<{лечи̂ко}[,]>\pr<レチーコ>\ct<>\an<>\ja<>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<>>
      \li<\sh<{шоду̂ту̀к}>\pr<ショドゥートゥーク>\ct<>\an<>\ja<>>
      \li<\sh<{ӈа}>\pr<ガ>\ct<>\an<>\ja<>>
      \li<\sh<{ту̂л}>\pr<トゥール>\ct<>\an<>\ja<>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<>\an<>\ja<>>
      \li<\sh<{е̂ко}>\pr<エーコ>\ct<>\an<>\ja<>>
      \li<\sh<{коццу̂ако}>\pr<コッツーワコ>\ct<>\an<>\ja<>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<>>
      \li<\sh<{момаххи̂з}[.]>\pr<モマッヒーズ>\ct<>\an<>\ja<>>
    >
    \ja<
      そのたびに人々が集まりましたが、いつもそれが嘘だと知って立ち去りました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Хед}>\pr<ヘド>\ct<>\an<>\ja<>>
      \li<\sh<{то̂се}>\pr<トーセ>\ct<>\an<>\ja<>>
      \li<\sh<{молси̂}>\pr<モルシー>\ct<>\an<>\ja<>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチ>\ct<>\an<>\ja<>>
      \li<\sh<{ло̂ва}>\pr<ローヴァ>\ct<>\an<>\ja<>>
      \li<\sh<{сами̂лла}>\pr<サミーッラ>\ct<>\an<>\ja<>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<>>
      \li<\sh<{ге̂з}[.]>\pr<ゲーズ>\ct<>\an<>\ja<>>
    >
    \ja<
      そのようなことの後、 少年は狼が近づいてくるのを見て叫びました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ло̂во}[!]>\pr<ローヴォ>\ct<>\an<>\ja<>>
      \li<\sh<{Бо̀}>\pr<ボー>\ct<>\an<>\ja<>>
      \li<\sh<{тесми̂м}>\pr<テスミーム>\ct<>\an<>\ja<>>
      \li<\sh<{и̂ддес}[!]>\pr<イーッデス>\ct<>\an<>\ja<>>
    >
    \ja<
      狼だ! こっちに来て!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Екку̂т}>\pr<エックート>\ct<>\an<>\ja<>>
      \li<\sh<{ес}>\pr<エス>\ct<>\an<>\ja<>>
      \li<\sh<{ӈ’}>\pr<ガ>\ct<>\an<>\ja<>>
      \li<\sh<{ажже̂с}>\pr<アッジェース>\ct<>\an<>\ja<>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<>>
      \li<\sh<{лассе̂}>\pr<ラッセー>\ct<>\an<>\ja<>>
      \li<\sh<{таффу̂зла}[.]>\pr<タッフーズラ>\ct<>\an<>\ja<>>
    >
    \ja<
      しかし、誰もそれを信じず助けにも向かいませんでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лоло̂во}>\pr<ロローヴォ>\ct<>\an<>\ja<>>
      \li<\sh<{саг}>\pr<サグ>\ct<>\an<>\ja<>>
      \li<\sh<{гафги̂фо}[,]>\pr<ガフギーフォ>\ct<>\an<>\ja<>>
      \li<\sh<{зале̂ро}>\pr<ザレーロ>\ct<>\an<>\ja<>>
      \li<\sh<{ажжо̂сот}>\pr<アッジョーソト>\ct<>\an<>\ja<>>
      \li<\sh<{воскаху̂злот}[,]>\pr<ヴォスカフーズロト>\ct<>\an<>\ja<>>
      \li<\sh<{лу̂цзѐ}>\pr<ルーツゼー>\ct<>\an<>\ja<>>
      \li<\sh<{леншу̂фашша}[.]>\pr<レンシューファッシャ>\ct<>\an<>\ja<>>
    >
    \ja<
      そのため、狼は何にも邪魔されずに羊を全て食べてしまいました。
    >
  >

>