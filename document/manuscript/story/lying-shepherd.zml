\zml?|version="1.1"|;
\xml?|version="1.0",encoding="UTF-8"|;


\story|id="story-lying-shepherd"|<
  \title<
    \sh<Футтач коццемуак>
    \ja<嘘つきの少年>
  >
  
  \sentence<
    \gloss<
      \li<\sh<{Аффе̂дди}>\pr<アッフェーッディ>\ct<名詞>\an<>\ja<あるところ>>
      \li<\sh<{ахху̂з}>\pr<アッフーズ>\ct<動詞>\an<>\ja<立つ>>
      \li<\sh<{фу̂ттач}>\pr<フーッタチ>\ct<名詞>\an<>\ja<少年>>
      \li<\sh<{мешу̂фашшарецесу̂ӈак}>\pr<メシューファッシャレツェスーガク>\ct<名詞>\an<>\ja<羊飼い>>
      \li<\sh<{це}>\pr<ツェ>\ct<前置辞>\an<>\ja<～の上に>>
      \li<\sh<{нефи̂гзи}>\pr<ネフィーフズィ>\ct<名詞>\an<>\ja<丘>>
      \li<\sh<{фефу̂хти}>\pr<フェフーフティ>\ct<形容詞>\an<>\ja<小高い>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{зери̂ш}>\pr<ゼリーシ>\ct<動詞>\an<>\ja<叫ぶ>>
      \li<\sh<{ри̂ццалот}>\pr<リーッツァロト>\ct<名詞>\an<>\ja<回>>
      \li<\sh<{би̂зот}[.]>\pr<ビーゾト>\ct<形容詞>\an<>\ja<多くの>>
    >
    \ja<
      あるところで、羊飼いの少年が小高い丘の上に立って、何度も叫びました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Таффу̂зла}[!]>\pr<タッフーズラ>\ct<>\an<>\ja<助ける>>
      \li<\sh<{Ло̂во}[!]>\pr<ローヴォ>\ct<>\an<>\ja<狼>>
    >
    \ja<
      助けて! 狼だ!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ду̂вѐ}>\pr<ドゥーウェー>\ct<>\an<>\ja<複数の>>
      \li<\sh<{са}>\pr<サ>\ct<>\an<>\ja<すると>>
      \li<\sh<{лобоҕсо̂аш}>\pr<ロボグソーワシ>\ct<>\an<>\ja<農家>>
      \li<\sh<{часи̂вве}>\pr<チャスィーッヴェ>\ct<>\an<>\ja<走る>>
      \li<\sh<{ро}>\pr<ロ>\ct<>\an<>\ja<～の方>>
      \li<\sh<{те̂ддес}[.]>\pr<テーッデス>\ct<>\an<>\ja<そこ>>
    >
    \ja<
      すると、農家たちはそちらの方へ走っていきました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Чо̀к}>\pr<チョーク>\ct<>\an<>\ja<だけ>>
      \li<\sh<{заби̂ҕҕе}>\pr<ザビーッゲ>\ct<>\an<>\ja<分かる>>
      \li<\sh<{ӈа}>\pr<ガ>\ct<>\an<>\ja<しかし>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<>\an<>\ja<～ということ>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチ>\ct<>\an<>\ja<少年>>
      \li<\sh<{ажж’}>\pr<アッジ>\ct<>\an<>\ja<～しない>>
      \li<\sh<{ери̂шан}>\pr<エリーシャン>\ct<>\an<>\ja<言う>>
      \li<\sh<{и̂кта}>\pr<イークタ>\ct<>\an<>\ja<真実>>
      \li<\sh<{шу̂то̀ӈ}[.]>\pr<シュートーン>\ct<>\an<>\ja<全く>>
    >
    \ja<
      しかし、少年が本当のことを全く言っていなかったと分かっただけでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<>\an<>\ja<それ>>
      \li<\sh<{ассади̂ц}>\pr<アッサディーツ>\ct<>\an<>\ja<繰り返す>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチ>\ct<>\an<>\ja<少年>>
      \li<\sh<{ри̂ццалот}>\pr<リーッツァロト>\ct<>\an<>\ja<回>>
      \li<\sh<{би̂зот}[.]>\pr<ビーゾト>\ct<>\an<>\ja<多くの>>
    >
    \ja<
      それを少年は何度も繰り返しました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Сечу̂ку̀}>\pr<セチュークー>\ct<>\an<>\ja<それぞれの>>
      \li<\sh<{лоду̂сре}>\pr<ロドゥースレ>\ct<>\an<>\ja<時>>
      \li<\sh<{вешти̂ез}>\pr<ベシティーイェズ>\ct<>\an<>\ja<集まる>>
      \li<\sh<{лечи̂ко}[,]>\pr<レチーコ>\ct<>\an<>\ja<人>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<そして>>
      \li<\sh<{шоду̂ту̀к}>\pr<ショドゥートゥーク>\ct<>\an<>\ja<いつも>>
      \li<\sh<{ӈа}>\pr<ガ>\ct<>\an<>\ja<しかし>>
      \li<\sh<{ту̂л}>\pr<トゥール>\ct<>\an<>\ja<知る>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<>\an<>\ja<～ということ>>
      \li<\sh<{е̂ко}>\pr<エーコ>\ct<>\an<>\ja<である>>
      \li<\sh<{коццу̂ако}>\pr<コッツーワコ>\ct<>\an<>\ja<嘘>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<そして>>
      \li<\sh<{момаххи̂з}[.]>\pr<モマッヒーズ>\ct<>\an<>\ja<立ち去る>>
    >
    \ja<
      そのたびに人々が集まりましたが、いつもそれが嘘だと知って立ち去りました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Хед}>\pr<ヘド>\ct<>\an<>\ja<～の後>>
      \li<\sh<{то̂се}>\pr<トーセ>\ct<>\an<>\ja<それ>>
      \li<\sh<{молси̂}>\pr<モルシー>\ct<>\an<>\ja<見る>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチ>\ct<>\an<>\ja<少年>>
      \li<\sh<{ло̂ва}>\pr<ローヴァ>\ct<>\an<>\ja<狼>>
      \li<\sh<{сами̂лла}>\pr<サミーッラ>\ct<>\an<>\ja<近づく>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<そして>>
      \li<\sh<{ге̂з}[.]>\pr<ゲーズ>\ct<>\an<>\ja<叫ぶ>>
    >
    \ja<
      そのようなことの後、 少年は狼が近づいてくるのを見て叫びました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ло̂во}[!]>\pr<ローヴォ>\ct<>\an<>\ja<狼>>
      \li<\sh<{Бо̀}>\pr<ボー>\ct<>\an<>\ja<～しろ>>
      \li<\sh<{тесми̂м}>\pr<テスミーム>\ct<>\an<>\ja<来る>>
      \li<\sh<{и̂ддес}[!]>\pr<イーッデス>\ct<>\an<>\ja<ここ>>
    >
    \ja<
      狼だ! こっちに来て!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Екку̂т}>\pr<エックート>\ct<>\an<>\ja<信じる>>
      \li<\sh<{ес}>\pr<エス>\ct<>\an<>\ja<彼>>
      \li<\sh<{ӈ’}>\pr<ガ>\ct<>\an<>\ja<しかし>>
      \li<\sh<{ажже̂с}>\pr<アッジェース>\ct<>\an<>\ja<誰もしない>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<そして>>
      \li<\sh<{лассе̂}>\pr<ラッセー>\ct<>\an<>\ja<向かう>>
      \li<\sh<{таффу̂злос}[.]>\pr<タッフーズラ>\ct<>\an<>\ja<助ける>>
    >
    \ja<
      しかし、誰もそれを信じず助けにも向かいませんでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лоло̂во}>\pr<ロローヴォ>\ct<>\an<>\ja<狼>>
      \li<\sh<{саг}>\pr<サグ>\ct<>\an<>\ja<そのため>>
      \li<\sh<{гафги̂фо}[,]>\pr<ガフギーフォ>\ct<>\an<>\ja<食べる>>
      \li<\sh<{зале̂ро}>\pr<ザレーロ>\ct<>\an<>\ja<持つ>>
      \li<\sh<{ажжо̂сот}>\pr<アッジョーソト>\ct<>\an<>\ja<何もない>>
      \li<\sh<{воскаху̂злот}[,]>\pr<ヴォスカフーズロト>\ct<>\an<>\ja<邪魔する>>
      \li<\sh<{лу̂цзѐ}>\pr<ルーツゼー>\ct<>\an<>\ja<全ての>>
      \li<\sh<{леншу̂фашша}[.]>\pr<レンシューファッシャ>\ct<>\an<>\ja<羊>>
    >
    \ja<
      そのため、狼は何にも邪魔されずに全ての羊を食べてしまいました。
    >
  >

>