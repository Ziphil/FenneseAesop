\story|id="story-lying-shepherd"|<
  \title<
    \sh<Ф\d|t="c"|<у>ттач коццем\d|t="c"|<у>ак>
    \ja<嘘つきの少年>
  >
  
  \sentence<
    \gloss<
      \li<\sh<{Аффе̂дди}>\pr<アッフェーッディ>\ct<名詞 (水類)>\an<連用·主格>\ja<あるところ>>
      \li<\sh<{ахху̂з}>\pr<アッフーズ>\ct<動詞>\an<能動態·現在時制·三人称·不定·水類>\ja<立つ>>
      \li<\sh<{фу̂ттач}>\pr<フーッタチュ>\ct<名詞 (水類)>\an<連用·主格·不定>\ja<少年>>
      \li<\sh<{мешу̂фашшарецесу̂ӈак}>\pr<メシューファッシャレツェスーガク>\ct<名詞 (水類)>\an<連用·主格·不定>\ja<羊飼い>>
      \li<\sh<{це}>\pr<ツェ>\ct<前置辞>\an<—>\ja<～の上に>>
      \li<\sh<{нефи̂гзи}>\pr<ネフィーフズィ>\ct<名詞 (水類)>\an<連用·処格·不定>\ja<丘>>
      \li<\sh<{фефу̂хти}>\pr<フェフーフティ>\ct<形容詞>\an<水類·連用·処格·不定>\ja<小高い>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{зери̂ш}>\pr<ゼリーシュ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<叫ぶ>>
      \li<\sh<{ри̂ццалот}>\pr<リーッツァロト>\ct<名詞 (水類)>\an<連用·具格·不定>\ja<回>>
      \li<\sh<{би̂зот}[.]>\pr<ビーゾト>\ct<形容詞>\an<水類·連用·具格·不定>\ja<多くの>>
    >
    \ja<
      あるところで、羊飼いの少年が小高い丘の上に立って、何度も叫びました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Таффу̂зла}[!]>\pr<タッフーズラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<助ける>>
      \li<\sh<{Ло̂во}[!]>\pr<ローヴォ>\ct<名詞 (火類)>\an<連用·主格·不定>\ja<狼>>
    >
    \ja<
      助けて! 狼だ!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ду̂вѐ}>\pr<ドゥーウェー>\ct<形容詞>\an<前置·水類>\ja<複数の>>
      \li<\sh<{са}>\pr<サ>\ct<小辞>\an<—>\ja<すると>>
      \li<\sh<{лобоҕсо̂аш}>\pr<ロボグソーワシ>\ct<名詞 (水類)>\an<連用·主格·定>\ja<農家>>
      \li<\sh<{часи̂вве}>\pr<チャスィーッヴェ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<走る>>
      \li<\sh<{ро}>\pr<ロ>\ct<前置辞>\an<—>\ja<～の方>>
      \li<\sh<{те̂ддес}[.]>\pr<テーッデス>\ct<名詞 (水類)>\an<連用·与格>\ja<そこ>>
    >
    \ja<
      すると、農家たちはそちらの方へ走って行きました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Чо̀к}>\pr<チョーク>\ct<汎詞>\an<—>\ja<だけ>>
      \li<\sh<{заби̂ҕҕе}>\pr<ザビーッゲ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<分かる>>
      \li<\sh<{ӈа}>\pr<ガ>\ct<小辞>\an<—>\ja<しかし>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<名詞>\an<連用·対格>\ja<～ということ>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチュ>\ct<名詞 (水類)>\an<連用·主格·定>\ja<少年>>
      \li<\sh<{ажж’}>\pr<アッジ>\ct<機能辞>\an<—>\ja<～しない>>
      \li<\sh<{ери̂шан}>\pr<エリーシャン>\ct<動詞>\an<能動態·過去時制·三人称·定·水類>\ja<言う>>
      \li<\sh<{и̂кта}>\pr<イークタ>\ct<名詞 (火類)>\an<連用·対格·不定>\ja<真実>>
      \li<\sh<{шу̂то̀ӈ}[.]>\pr<シュートーン>\ct<副詞>\an<—>\ja<全く>>
    >
    \ja<
      しかし、少年が本当のことを全く言っていなかったと分かっただけでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<>\an<>\ja<それ>>
      \li<\sh<{ассади̂ц}>\pr<アッサディーツ>\ct<>\an<>\ja<繰り返す>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチュ>\ct<>\an<>\ja<少年>>
      \li<\sh<{ри̂ццалот}>\pr<リーッツァロト>\ct<>\an<>\ja<回>>
      \li<\sh<{би̂зот}[.]>\pr<ビーゾト>\ct<>\an<>\ja<多くの>>
    >
    \ja<
      それを少年は何度も繰り返しました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Сечу̂ку̀}>\pr<セチュークー>\ct<形容詞>\an<前置·火類>\ja<それぞれの>>
      \li<\sh<{лоду̂сре}>\pr<ロドゥースレ>\ct<名詞 (火類)>\an<連用·処格·定>\ja<時>>
      \li<\sh<{вешти̂ез}>\pr<ベシティーイェズ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<集まる>>
      \li<\sh<{лечи̂ко}[,]>\pr<レチーコ>\ct<名詞 (水類)>\an<連用·主格·定>\ja<人>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{шоду̂ту̀к}>\pr<ショドゥートゥーク>\ct<副詞>\an<—>\ja<いつも>>
      \li<\sh<{ӈа}>\pr<ガ>\ct<小辞>\an<—>\ja<しかし>>
      \li<\sh<{ту̂л}>\pr<トゥール>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<知る>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<名詞>\an<連用·対格>\ja<～ということ>>
      \li<\sh<{е̂ко}>\pr<エーコ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<である>>
      \li<\sh<{коццу̂ако}>\pr<コッツーワコ>\ct<名詞 (火類)>\an<連用·主格·不定>\ja<嘘>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{момаххи̂з}[.]>\pr<モマッヒーズ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<立ち去る>>
    >
    \ja<
      そのたびに人々が集まりましたが、いつもそれが嘘だと知って立ち去りました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Хед}>\pr<ヘド>\ct<前置辞>\an<—>\ja<～の後>>
      \li<\sh<{то̂се}>\pr<トーセ>\ct<名詞>\an<火類·連用·処格>\ja<それ>>
      \li<\sh<{молси̂}>\pr<モルシー>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<見る>>
      \li<\sh<{лефу̂ттач}>\pr<レフーッタチュ>\ct<名詞 (水類)>\an<連用·主格·定>\ja<少年>>
      \li<\sh<{ло̂ва}>\pr<ローヴァ>\ct<名詞 (火類)>\an<連用·対格·不定>\ja<狼>>
      \li<\sh<{сами̂лла}>\pr<サミーッラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<近づく>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{ге̂з}[.]>\pr<ゲーズ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<叫ぶ>>
    >
    \ja<
      そのようなことの後、 少年は狼が近づいてくるのを見て叫びました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ло̂во}[!]>\pr<ローヴォ>\ct<名詞 (火類)>\an<連用·主格·不定>\ja<狼>>
      \li<\sh<{Бо̀}>\pr<ボー>\ct<機能辞>\an<—>\ja<～しろ>>
      \li<\sh<{тесми̂м}>\pr<テスミーム>\ct<動詞>\an<能動態·現在時制·二人称·水類>\ja<来る>>
      \li<\sh<{и̂ддес}[!]>\pr<イーッデス>\ct<名詞 (水類)>\an<連用·与格>\ja<ここ>>
    >
    \ja<
      狼だ! こっちに来て!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Екку̂т}>\pr<エックート>\ct<動詞>\an<能動態·現在時制·三人称·不定·水類>\ja<信じる>>
      \li<\sh<{ес}>\pr<エス>\ct<名詞>\an<水類·連用·主格·不定>\ja<彼>>
      \li<\sh<{ӈ’}>\pr<ガ>\ct<小辞>\an<—>\ja<しかし>>
      \li<\sh<{ажже̂с}>\pr<アッジェース>\ct<名詞>\an<水類·連用·主格>\ja<誰もしない>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{лассе̂}>\pr<ラッセー>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<向かう>>
      \li<\sh<{таффу̂злос}[.]>\pr<タッフーズラ>\ct<動詞>\an<動名詞·能動態·連用·与格·不定>\ja<助ける>>
    >
    \ja<
      しかし、誰もそれを信じず助けにも向かいませんでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лоло̂во}>\pr<ロローヴォ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<狼>>
      \li<\sh<{саг}>\pr<サグ>\ct<小辞>\an<—>\ja<そのため>>
      \li<\sh<{гафги̂фо}[,]>\pr<ガフギーフォ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<食べる>>
      \li<\sh<{зале̂ро}>\pr<ザレーロ>\ct<動詞>\an<動形容詞·能動態·火類·連用·主格·不定>\ja<持つ>>
      \li<\sh<{ажжо̂сот}>\pr<アッジョーソト>\ct<名詞>\an<水類·連用·具格>\ja<何もない>>
      \li<\sh<{воскаху̂злут}[,]>\pr<ヴォスカフーズロト>\ct<動詞>\an<動名詞·能動態·連用·具格·不定>\ja<邪魔する>>
      \li<\sh<{лу̂цзѐ}>\pr<ルーツゼー>\ct<形容詞>\an<前置·水類>\ja<全ての>>
      \li<\sh<{леншу̂фашша}[.]>\pr<レンシューファッシャ>\ct<名詞 (水類)>\an<連用·対格·定>\ja<羊>>
    >
    \ja<
      そのため、狼は何にも邪魔されずに全ての羊を食べてしまいました。
    >
  >

>