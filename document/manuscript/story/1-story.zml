\story|id="1"|<
  \title<ウサギとカメ>

  \sentence<
    \gloss<
      \li<\sh<{Аффѐ}>\pr<アッフェー>\ct<形容詞>\an<用.水.主>\ja<とある>>
      \li<\sh<{ки̂шшари}>\pr<キーッシャリ>\ct<名詞>\an<用.主.不定>\ja<日>>
      \li<\sh<{босси̂р}>\pr<ボッシール>\ct<動詞>\an<能.現.三.定.水>\ja<嘲笑う>>
      \li<\sh<{лефи̂ллат}>\pr<レフィーッラト>\ct<名詞>\an<用.主.定>\ja<ウサギ>>
      \li<\sh<{лото̂ртаҕос}>\pr<ロトールタゴス>\ct<名詞>\an<用.与.定>\ja<カメ>>
      \li<\sh<{ò}>\pr<オー>\ct<形容詞>\an<用.火.対>\ja<彼の>>
      \li<\sh<{лоти̂лга}[.]>\pr<ロティールガ>\ct<名詞>\an<用.対.定>\ja<脚>>
      ## \li<\sh<{}>\pr<>\ct<>\an<>\ja<>>
    >
    \ja<
      ある日、ウサギがカメの脚のことを嘲笑いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ери̂шо}>\pr<エリーショ>\ct<動詞>\an<能.現.三.定.水>\ja<言う>>
      \li<\sh<{лото̂ртаҕо}[.]>\pr<ロトールタゴ>\ct<名詞>\an<用.主.定>\ja<カメ>>
    >
    \ja<
      カメは言いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Но̂ч}[?]>\pr<ノーチ>\ct<間投詞>\an<—>\ja<何>>
    >
    \ja<
      本当にそうかな?
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Егту̂кко}>\pr<エグトゥーッコ>\ct<動詞>\an<能.現.三.定.火>\ja<確信する>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<名詞>\an<用.対>\ja<～ということ>>
      \li<\sh<{е̂ццо}>\pr<エーッツォ>\ct<名詞>\an<用.火.主>\ja<私>>
      \li<\sh<{екодфахи̂то}>\pr<エコドファヒート>\ct<動詞>\an<能.現.三.定.火>\ja<勝つ>>
      \li<\sh<{шес}>\pr<シェス>\ct<名詞>\an<用.水.主>\ja<君>>
      \li<\sh<{коччаси̂влут}[.]>\pr<コッチャスィーヴルト>\ct<動詞>\an<名.能.用.具>\ja<競走する>>
    >
    \ja<
      私は競走で君に勝てると確信しているよ。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Оцери̂ш}>\pr<オチェリーシ>\ct<>\an<>\ja<答える>>
      \li<\sh<{га}>\pr<ガ>\ct<>\an<>\ja<一方で>>
      \li<\sh<{лефи̂ллат}[.]>\pr<レフィーッラト>\ct<>\an<>\ja<ウサギ>>
    >
    \ja<
      すると、 ウサギは答えました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<>\an<>\ja<それ>>
      \li<\sh<{чо̀к}>\pr<チョーク>\ct<>\an<>\ja<だけ>>
      \li<\sh<{тери̂шно}[.]>\pr<テリーシノ>\ct<>\an<>\ja<言う>>
    >
    \ja<
      そんなの口先だけだ。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{И́та}>\pr<イタ>\ct<>\an<>\ja<では>>
      \li<\sh<{бо̀}>\pr<ボー>\ct<>\an<>\ja<～しよう>>
      \li<\sh<{бамекодгасу̂в}>\pr<バメコドガスーヴ>\ct<>\an<>\ja<勝負する>>
      \li<\sh<{аццани̂лос}[.]>\pr<アッツァニーロス>\ct<>\an<>\ja<はっきりさせる>>
    >
    \ja<
      では、 はっきりさせるために勝負しよう。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ашну̂лез}>\pr<アシヌーレズ>\ct<>\an<>\ja<するのが良い>>
      \li<\sh<{ку̂к}>\pr<クーク>\ct<>\an<>\ja<～ということ>>
      \li<\sh<{не̂с}>\pr<ネース>\ct<>\an<>\ja<誰>>
      \li<\sh<{ҕаллу̂з}>\pr<ガッルーズ>\ct<>\an<>\ja<決める>>
      \li<\sh<{лесду̂ка}>\pr<レスドゥーカ>\ct<>\an<>\ja<場所>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<と>>
      \li<\sh<{ложи̂кеа}>\pr<ロジーケヤ>\ct<>\an<>\ja<時間>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<と>>
      \li<\sh<{фезассу̂б}[?]>\pr<フェザッスーブ>\ct<>\an<>\ja<審判する>>
    >
    \ja<
      場所と時間を決めて審判をするのは誰が良いだろうか?
    >
  >

>