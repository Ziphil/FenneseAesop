\zml?|version="1.1"|;
\xml?|version="1.0",encoding="UTF-8"|;


\story|id="story-fox-grapes"|<
  \title<
    \sh<Согитач вегибаш>
    \ja<酸っぱいブドウ>
  >

  \sentence<
    \gloss<
      \li<\sh<{Со̂рро}>\pr<ソーッロ>\ct<名詞>\an<>\ja<キツネ>>
      \li<\sh<{молси̂}>\pr<モルスィー>\ct<動詞>\an<>\ja<見る>>
      \li<\sh<{цефи̂мо}>\pr<ツェフーモ>\ct<名詞>\an<>\ja<房>>
      \li<\sh<{соги̂ччев}>\pr<ソギーッチェヴ>\ct<名詞>\an<>\ja<ブドウ>>
      \li<\sh<{ту̂хив}>\pr<トゥーヒヴ>\ct<形容詞>\an<>\ja<熟れた>>
      \li<\sh<{чаду̂хрез}>\pr<チャドゥーフレズ>\ct<動詞>\an<>\ja<吊り下がる>>
      \li<\sh<{ку̂ҕажжи}>\pr<クーガッジ>\ct<名詞>\an<>\ja<柵>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{зо̂ро}>\pr<ゾーロ>\ct<動詞>\an<>\ja<望む>>
      \li<\sh<{си̂нла}>\pr<シーンラ>\ct<動詞>\an<>\ja<食べる>>
      \li<\sh<{ех}[.]>\pr<エフ>\ct<名詞>\an<>\ja<それ>>
    >
    \ja<
      キツネが柵に吊り下がった熟れたブドウの房を見て、それを食べたいと思いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Су̂к}>\pr<スーク>\ct<動詞>\an<>\ja<ある>>
      \li<\sh<{ҕа}>\pr<ガ>\ct<小辞>\an<>\ja<しかし>>
      \li<\sh<{фу̂хти}[,]>\pr<フーフティ>\ct<名詞>\an<>\ja<高いところ>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{’жжа}>\pr<ッジャ>\ct<—>\an<>\ja<～しない>>
      \li<\sh<{та̂ду}>\pr<タドゥー>\ct<動詞>\an<>\ja<できる>>
      \li<\sh<{саг}>\pr<サグ>\ct<小辞>\an<>\ja<したがって>>
      \li<\sh<{ҕафи̂ла}>\pr<ガフィーラ>\ct<動詞>\an<>\ja<手に入れる>>
      \li<\sh<{ех}[.]>\pr<エフ>\ct<名詞>\an<>\ja<それ>>
    >
    \ja<
      しかし、それは高いところにあったので、それを手に入れることはできませんでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<名詞>\an<>\ja<それ>>
      \li<\sh<{амолси̂}>\pr<アモルスィー>\ct<動詞>\an<>\ja<見る>>
      \li<\sh<{ре̂тан}>\pr<レータン>\ct<名詞>\an<>\ja<ネズミ>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{сахху̂нар}>\pr<サッフーナル>\ct<動詞>\an<>\ja<笑う>>
      \li<\sh<{ери̂ш}[.]>\pr<エリーシュ>\ct<動詞>\an<>\ja<言う>>
    >
    \ja<
      それをネズミが見て、笑いながら言いました。 
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂ччо̀ӈ}>\pr<トーッチョーン>\ct<副詞>\an<>\ja<そのように>>
      \li<\sh<{тозлу̂о}>\pr<トズルーウォ>\ct<動詞>\an<>\ja<ままでいる>>
      \li<\sh<{си̂нро}>\pr<シーンロ>\ct<動詞>\an<>\ja<食べる>>
      \li<\sh<{ажжо̂са}[!]>\pr<アジョーサ>\ct<名詞>\an<>\ja<何もない>>
    >
    \ja<
      そうやって何も食べられないままでいるんだな!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лосо̂рро}>\pr<ロッソーロ>\ct<名詞>\an<>\ja<キツネ>>
      \li<\sh<{са}>\pr<ガ>\ct<小辞>\an<>\ja<すると>>
      \li<\sh<{хавву̂то}>\pr<ハッヴート>\ct<動詞>\an<>\ja<嫌がる>>
      \li<\sh<{ех}>\pr<エフ>\ct<名詞>\an<>\ja<彼>>
      \li<\sh<{маси̂пла}>\pr<マシープラ>\ct<動詞>\an<>\ja<触る>>
      \li<\sh<{лефи̂хта}>\pr<レフィーフタ>\ct<名詞>\an<>\ja<上方>>
      \li<\sh<{лезу̂севзам}>\pr<レズーセヴザム>\ct<名詞>\an<>\ja<自分>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{оцери̂шо}[.]>\pr<オツェリーショ>\ct<動詞>\an<>\ja<返事する>>
    >
    \ja<
      すると、キツネはネズミが自分を見下しているのを嫌がって、返事をしました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Хѐ}>\pr<ヘー>\ct<形容詞>\an<>\ja<あの>>
      \li<\sh<{лесги̂тач}>\pr<レスギータチュ>\ct<名詞>\an<>\ja<ブドウ>>
      \li<\sh<{е̂к}>\pr<エーク>\ct<動詞>\an<>\ja<である>>
      \li<\sh<{веги̂баш}[!]>\pr<ベギーバシュ>\ct<形容詞>\an<>\ja<酸っぱい>>
    >
    \ja<
      あのブドウは酸っぱいんだ!
    >
  >

>