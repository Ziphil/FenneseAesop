\story|id="story-fox-grapes"|<
  \title<
    \sh<Сог\d|t="c"|<и>тач вег\d|t="c"|<и>баш>
    \ja<酸っぱいブドウ>
  >

  \sentence<
    \gloss<
      \li<\sh<{Со̂рро}>\pr<ソーッロ>\ct<名詞 (火類)>\an<連用·主格·不定>\ja<キツネ>>
      \li<\sh<{молси̂}>\pr<モルスィー>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<見る>>
      \li<\sh<{цефи̂мо}>\pr<ツェフーモ>\ct<名詞 (水類)>\an<連用·対格·不定>\ja<房>>
      \li<\sh<{соги̂ччев}>\pr<ソギーッチェヴ>\ct<名詞 (水類)>\an<連体·主格·不定>\ja<ブドウ>>
      \li<\sh<{ту̂хив}>\pr<トゥーヒヴ>\ct<形容詞>\an<水類·連体·主格·不定>\ja<熟れた>>
      \li<\sh<{чаду̂храз}>\pr<チャドゥーフラズ>\ct<動詞>\an<動形容詞·能動態·水類·連用·対格·不定>\ja<吊り下がる>>
      \li<\sh<{ку̂ҕажжи}>\pr<クーガッジ>\ct<名詞 (水類)>\an<連用·処格·不定>\ja<柵>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{зо̂ро}>\pr<ゾーロ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<望む>>
      \li<\sh<{си̂нла}>\pr<スィーンラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<食べる>>
      \li<\sh<{ех}[.]>\pr<エフ>\ct<名詞>\an<水類·連用·対格>\ja<それ>>
    >
    \ja<
      あるキツネが、柵に吊り下がった熟れたブドウの房を見て、それを食べたいと思いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Су̂к}>\pr<スーク>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<ある>>
      \li<\sh<{ҕа}>\pr<ガ>\ct<小辞>\an<—>\ja<しかし>>
      \li<\sh<{фу̂хти}[,]>\pr<フーフティ>\ct<名詞 (水類)>\an<連用·処格·不定>\ja<高いところ>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{’жжа}>\pr<ッジャ>\ct<機能辞>\an<—>\ja<～しない>>
      \li<\sh<{таду̂}>\pr<タドゥー>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<できる>>
      \li<\sh<{саг}>\pr<サグ>\ct<小辞>\an<—>\ja<したがって>>
      \li<\sh<{ҕафи̂ла}>\pr<ガフィーラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<手に入れる>>
      \li<\sh<{ех}[.]>\pr<エフ>\ct<名詞>\an<水類·連用·対格>\ja<それ>>
    >
    \ja<
      しかし、それは高いところにあったので、それを手に入れることはできませんでした。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<名詞>\an<火類·連用·対格>\ja<それ>>
      \li<\sh<{амолси̂}>\pr<アモルスィー>\ct<動詞>\an<能動態·現在時制·三人称·不定·水類>\ja<見る>>
      \li<\sh<{ре̂тан}>\pr<レータン>\ct<名詞 (水類)>\an<連用·主格·不定>\ja<ネズミ>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{сахху̂нар}>\pr<サッフーナル>\ct<動詞>\an<動形容詞·能動態·水類·連用·主格·不定>\ja<笑う>>
      \li<\sh<{ери̂ш}[.]>\pr<エリーシュ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<言う>>
    >
    \ja<
      それをネズミが見て、笑いながら言いました。 
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂ччо̀ӈ}>\pr<トーッチョーン>\ct<副詞>\an<—>\ja<そのように>>
      \li<\sh<{тозлу̂о}>\pr<トズルーウォ>\ct<動詞>\an<能動態·現在時制·二人称·火類>\ja<ままでいる>>
      \li<\sh<{си̂нро}>\pr<スィーンロ>\ct<動詞>\an<動形容詞·能動態·火類·連用·主格·不定>\ja<食べる>>
      \li<\sh<{ажжо̂са}[!]>\pr<アジョーサ>\ct<名詞>\an<水類·連用·対格>\ja<何もない>>
    >
    \ja<
      そうやって何も食べられないままでいるんだな!
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лосо̂рро}>\pr<ロッソーロ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<キツネ>>
      \li<\sh<{са}>\pr<ガ>\ct<小辞>\an<—>\ja<すると>>
      \li<\sh<{хавву̂то}>\pr<ハッヴート>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<嫌がる>>
      \li<\sh<{ех}>\pr<エフ>\ct<名詞>\an<水類·連用·対格>\ja<彼>>
      \li<\sh<{маси̂пла}>\pr<マシープラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<触る>>
      \li<\sh<{лефи̂хта}>\pr<レフィーフタ>\ct<名詞 (水類)>\an<連用·対格·定>\ja<上方>>
      \li<\sh<{лезу̂севзам}>\pr<レズーセヴザム>\ct<名詞 (水類)>\an<連体·奪格·定>\ja<自分>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{оцери̂шо}[.]>\pr<オツェリーショ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<返事する>>
    >
    \ja<
      すると、キツネはネズミが自分を見下しているのを嫌がって、返事をしました。
    >
    \supl<
      前半を直訳すると「キツネは彼 (ネズミ) が自分の上方を触るのを嫌がって」となります。
      {маси̂п лефи̂хта}「～の上方を触る」というのはフェンナ語の慣用句で、「勝ったような態度をとる」や「マウントをとる」などといった意味合いがあります。
      ここでは「見下す」と訳しました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Хѐ}>\pr<ヘー>\ct<形容詞>\an<前置·水類>\ja<あの>>
      \li<\sh<{лесги̂тач}>\pr<レスギータチュ>\ct<名詞 (水類)>\an<連用·主格·定>\ja<ブドウ>>
      \li<\sh<{е̂к}>\pr<エーク>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<である>>
      \li<\sh<{веги̂баш}[!]>\pr<ベギーバシュ>\ct<形容詞>\an<水類·連用·主格·不定>\ja<酸っぱい>>
    >
    \ja<
      あのブドウは酸っぱいんだ!
    >
  >

>