\xml?|version="1.0",encoding="UTF-8"|;


\story|id="story-dog-reflection"|<
  \title<
    \sh<В\d|t="c"|<у>ву ӈадеф\d|t="c"|<у>тро м\d|t="c"|<и>цца>
    \ja<肉を咥えた犬>
  >

  \sentence<
    \gloss<
      \li<\sh<{Ву̂ву}>\pr<ヴーヴ>\ct<名詞>\an<>\ja<犬>>
      \li<\sh<{су̂ко}>\pr<スーコ>\ct<動詞>\an<>\ja<する>>
      \li<\sh<{габу̂чро}>\pr<ガブーチュロ>\ct<動詞>\an<>\ja<渡る>>
      \li<\sh<{ги̂ббачут}>\pr<ギーッバチュト>\ct<名詞>\an<>\ja<橋>>
      \li<\sh<{ӈадефу̂тро}>\pr<ナデフートロ>\ct<動詞>\an<>\ja<咥える>>
      \li<\sh<{ми̂цца}[.]>\pr<ミーッツァ>\ct<名詞>\an<>\ja<肉>>
    >
    \ja<
      ある犬が、 肉を咥えながら橋を渡っていました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Заби̂ҕҕо}>\pr<ザビーッゴ>\ct<動詞>\an<>\ja<見つける>>
      \li<\sh<{левевву̂ска}>\pr<レベッブースカ>\ct<名詞>\an<>\ja<影>>
      \li<\sh<{лезу̂сев}>\pr<レズーセヴ>\ct<名詞>\an<>\ja<自分>>
      \li<\sh<{ве}>\pr<ヴェ>\ct<前置辞>\an<>\ja<～の中>>
      \li<\sh<{лери̂си}[,]>\pr<レリーシ>\ct<名詞>\an<>\ja<水>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{веку̂жо}>\pr<ヴェクージョ>\ct<動詞>\an<>\ja<思い込む>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<名詞>\an<>\ja<～ということ>>
      \li<\sh<{асу̂ко}>\pr<アスーコ>\ct<動詞>\an<>\ja<いる>>
      \li<\sh<{ву̂ву}>\pr<ヴーヴ>\ct<名詞>\an<>\ja<犬>>
      \li<\sh<{би̂вассо}>\pr<ビーヴァッソ>\ct<形容詞>\an<>\ja<別の>>
      \li<\sh<{зале̂ро}>\pr<ザレーロ>\ct<動詞>\an<>\ja<持つ>>
      \li<\sh<{ми̂цца}>\pr<ミーッツァ>\ct<名詞>\an<>\ja<肉>>
      \li<\sh<{зи̂дхо̀}>\pr<ジードホー>\ct<連述詞>\an<>\ja<より>>
      \li<\sh<{ги̂на}[.]>\pr<ギーナ>\ct<形容詞>\an<>\ja<大きい>>
    >
    \ja<
      犬は、水の中に自分自身の影を見つけて、より大きな肉を持った別の犬がいるのだと思い込みました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Чел}>\pr<チェル>\ct<前置辞>\an<>\ja<～するために>>
      \li<\sh<{можакки̂лос}>\pr<モジャッキーロス>\ct<名詞>\an<>\ja<奪う>>
      \li<\sh<{хад}>\pr<ハド>\ct<小辞>\an<>\ja<そこで>>
      \li<\sh<{то̂са}[,]>\pr<トーサ>\ct<名詞>\an<>\ja<それ>>
      \li<\sh<{зобну̂хо}>\pr<ゾブヌーホ>\ct<動詞>\an<>\ja<手放す>>
      \li<\sh<{ломи̂цца}>\pr<ロミーッツァ>\ct<名詞>\an<>\ja<肉>>
      \li<\sh<{лезу̂сев}>\pr<レズーセヴ>\ct<名詞>\an<>\ja<自分>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{заӈӈи̂до}>\pr<ザッギード>\ct<名詞>\an<>\ja<突進する>>
      \li<\sh<{са}>\pr<サ>\ct<小辞>\an<>\ja<そして>>
      \li<\sh<{лесри̂сес}[.]>\pr<レスリーセス>\ct<名詞>\an<>\ja<川>>
    >
    \ja<
      そこで、それを奪うために、自分の肉を手放して川に突進しました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂сос}>\pr<トーサ>\ct<名詞>\an<>\ja<それ>>
      \li<\sh<{ӈ’}>\pr<ガ>\ct<小辞>\an<>\ja<しかし>>
      \li<\sh<{ажжа}>\pr<アッジャ>\ct<—>\an<>\ja<～しない>>
      \li<\sh<{заххи̂со}>\pr<ザッヒーソ>\ct<動詞>\an<>\ja<手が届く>>
      \li<\sh<[—]>>
      \li<\sh<{ажжа}>\pr<アッジャ>\ct<—>\an<>\ja<～しない>>
      \li<\sh<{боки̂врос}>\pr<ボキーヴラ>\ct<動詞>\an<>\ja<存在する>>
      \li<\sh<{лоцу̂нтозам}>\pr<ロツーントザム>\ct<名詞>\an<>\ja<最初>>
      \li<\sh<[—]>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<>\ja<そして>>
      \li<\sh<{лочи̂бу}>\pr<ロチーブ>\ct<名詞>\an<>\ja<もう一方>>
      \li<\sh<{сери̂соз}>\pr<セリーソズ>\ct<動詞>\an<>\ja<流れていく>>
      \li<\sh<{лесри̂сот}[.]>\pr<レスリーソト>\ct<名詞>\an<>\ja<川>>
    >
    \ja<
      しかし、それには手が届きませんでした――最初から存在しないのだから――そして、もう一方の肉は川を流れていってしまいました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Баму̂ҕҕезо}>\pr<ヴァムーッゲゾ>\ct<動詞>\an<>\ja<結局する>>
      \li<\sh<{ману̂жла}>\pr<マヌージュラ>\ct<動詞>\an<>\ja<失う>>
      \li<\sh<{ломи̂цца}>\pr<ロミーッツァ>\ct<名詞>\an<>\ja<肉>>
      \li<\sh<{би̂всевот}[.]>\pr<ビーヴセヴォト>\ct<名詞>\an<>\ja<2>>
    >
    \ja<
      結局、犬は 2 つの肉を失ったのです。
    >
  >

>