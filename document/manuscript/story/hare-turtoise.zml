\story|id="story-hare-turtoise"|<
  \title<
    \sh<Леф\d|t="c"|<и>ллат \d|t="a"|<и> лот\d|t="c"|<о>ртаҕо>
    \ja<ウサギとカメ>
  >

  \sentence<
    \gloss<
      \li<\sh<{Аффѐ}>\pr<アッフェー>\ct<形容詞>\an<前置·水類>\ja<とある>>
      \li<\sh<{ки̂шшари}>\pr<キーッシャリ>\ct<名詞 (水類)>\an<用言·主格·不定>\ja<日>>
      \li<\sh<{босси̂р}>\pr<ボッスィール>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<嘲笑う>>
      \li<\sh<{лефи̂ллат}>\pr<レフィーッラト>\ct<名詞 (水類)>\an<連用·主格·定>\ja<ウサギ>>
      \li<\sh<{лото̂ртаҕос}>\pr<ロトールタゴス>\ct<名詞 (火類)>\an<連用·与格·定>\ja<カメ>>
      \li<\sh<{ò}>\pr<オー>\ct<形容詞>\an<前置·火類>\ja<彼の>>
      \li<\sh<{лоти̂лга}[.]>\pr<ロティールガ>\ct<名詞 (火類)>\an<連用·対格·定>\ja<脚>>
    >
    \ja<
      ある日、ウサギがカメを脚について嘲笑いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ери̂шо}>\pr<エリーショ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<言う>>
      \li<\sh<{лото̂ртаҕо}[.]>\pr<ロトールタゴ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<カメ>>
    >
    \ja<
      カメは言いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Но̂ч}[?]>\pr<ノーチ>\ct<間投詞>\an<—>\ja<何>>
    >
    \ja<
      何だって?
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Егту̂кко}>\pr<エグトゥーッコ>\ct<動詞>\an<能動態·現在時制·一人称単数·火類>\ja<確信する>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<名詞>\an<連用·対格>\ja<～ということ>>
      \li<\sh<{е̂ццо}>\pr<エーッツォ>\ct<名詞>\an<火類·連用·主格>\ja<私>>
      \li<\sh<{екодфахи̂то}>\pr<エコドファヒート>\ct<動詞>\an<能動態·現在時制·一人称単数·火類>\ja<勝つ>>
      \li<\sh<{шес}>\pr<シェス>\ct<名詞>\an<水類·連用·与格>\ja<君>>
      \li<\sh<{коччаси̂влут}[.]>\pr<コッチャスィーヴルト>\ct<動詞>\an<動名詞·能動態·連用·具格·不定>\ja<競走する>>
    >
    \ja<
      私は競走で君に勝つことを確信しているよ。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Оцери̂ш}>\pr<オチェリーシ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<答える>>
      \li<\sh<{га}>\pr<ガ>\ct<小辞>\an<—>\ja<一方で>>
      \li<\sh<{лефи̂ллат}[.]>\pr<レフィーッラト>\ct<名詞 (水類)>\an<連用·主格·定>\ja<ウサギ>>
    >
    \ja<
      一方で、ウサギは答えました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<名詞>\an<火類·連用·対格>\ja<それ>>
      \li<\sh<{чо̀к}>\pr<チョーク>\ct<汎詞>\an<—>\ja<だけ>>
      \li<\sh<{тери̂шно}[.]>\pr<テリーシノ>\ct<動詞>\an<能動態·現在時制·二人称·火類>\ja<言う>>
    >
    \ja<
      そんなの口先だけだ。
    >
    \supl<
      直訳すると「それを言っているだけだ」になりますが、この表現は「行動が伴っていない」というニュアンスで使われることが多いので、ここでは「口先だけ」と訳してあります。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{И́та}>\pr<イタ>\ct<連結辞＋小辞>\an<—>\ja<では>>
      \li<\sh<{бо̀}>\pr<ボー>\ct<機能辞>\an<—>\ja<～しよう>>
      \li<\sh<{бамекодгасу̂в}>\pr<バメコドガスーヴ>\ct<動詞>\an<能動態·現在時制·一人称複数·水類>\ja<勝負する>>
      \li<\sh<{аццани̂лос}[.]>\pr<アッツァニーロス>\ct<動詞>\an<動名詞·能動態·連用·与格·不定>\ja<はっきりさせる>>
    >
    \ja<
      では、はっきりさせるために勝負しよう。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ашну̂лез}>\pr<アシヌーレズ>\ct<動詞>\an<能動態·現在時制·三人称·不定·水類>\ja<するのが良い>>
      \li<\sh<{ку̂к}>\pr<クーク>\ct<名詞>\an<連用·主格>\ja<～ということ>>
      \li<\sh<{не̂с}>\pr<ネース>\ct<名詞>\an<水類·連用·主格>\ja<誰>>
      \li<\sh<{ҕаллу̂з}>\pr<ガッルーズ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<決める>>
      \li<\sh<{лесду̂ка}>\pr<レスドゥーカ>\ct<名詞 (水類)>\an<連用·対格·定>\ja<場所>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<と>>
      \li<\sh<{ложи̂кеа}>\pr<ロジーケヤ>\ct<名詞 (火類)>\an<連用·対格·定>\ja<時間>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<と>>
      \li<\sh<{фезассу̂б}[?]>\pr<フェザッスーブ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<審判する>>
    >
    \ja<
      誰が場所と時間を決めて審判するのが良いだろうか?
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{И́с’}>\pr<イス>\ct<連結辞＋小辞>\an<—>\ja<すると>>
      \li<\sh<{оцери̂шо}[.]>\pr<オツェリーショ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<答える>>
    >
    \ja<
      すると、カメは答えました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лосо̂рро}[.]>\pr<ロソーッロ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<キツネ>>
    >
    \ja<
      キツネにしよう。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Е̂ко}>\pr<エーコ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<である>>
      \li<\sh<{маг}>\pr<マグ>\ct<小辞>\an<—>\ja<なぜなら>>
      \li<\sh<{веки̂ффу}>\pr<ヴェキーッフ>\ct<形容詞>\an<火類·連用·主格·不定>\ja<正直な>>
      \li<\sh<{и́бал}>\pr<イバル>\ct<連結辞＋小辞>\an<—>\ja<その上>>
      \li<\sh<{аззи̂ӈо}[.]>\pr<アッズィーゴ>\ct<形容詞>\an<火類·連用·主格·不定>\ja<賢明な>>
    >
    \ja<
      なぜなら、正直な上に賢明だから。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лосо̂рро}>\pr<ロソーッロ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<キツネ>>
      \li<\sh<{са}>\pr<サ>\ct<小辞>\an<—>\ja<そして>>
      \li<\sh<{ҕаллу̂зо}>\pr<ガッルーゾ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<決める>>
      \li<\sh<{ко̂ддa}>\pr<コーッダ>\ct<名詞 (火類)>\an<連用·対格>\ja<時間>>
      \li<\sh<{цану̂т}>\pr<ツァヌート>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<始める>>
      \li<\sh<{у}>\pr<ウ>\ct<名詞>\an<火類·連用·処格>\ja<そのとき>>
      \li<\sh<{локоччаси̂вла}[.]>\pr<ロコッチャスィーヴラ>\ct<動詞>\an<動名詞·能動態·連用·対格·定>\ja<競走する>>
    >
    \ja<
      キツネは競走を始める時間を決めました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ко̂ддео}>\pr<コーッデウォ>\ct<名詞 (火類)>\an<連用·処格>\ja<～するとき>>
      \li<\sh<{сами̂мо}>\pr<サミーモ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<来る>>
      \li<\sh<{ложи̂кео}[,]>\pr<ロジーケオ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<時間>>
      \li<\sh<{лото̂ртаҕо}>\pr<ロトールタゴ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<カメ>>
      \li<\sh<{цану̂то}>\pr<ツァヌート>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<始める>>
      \li<\sh<{ажжа}>\pr<アッジャ>\ct<機能辞>\an<—>\ja<～しない>>
      \li<\sh<{зами̂вро}>\pr<ザミーヴロ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<遅れる>>
      \li<\sh<{саву̂лла}[.]>\pr<サヴーッラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<進む>>
    >
    \ja<
      その時間が来たとき、カメは遅れることなく進み始めました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лефи̂ллат}>\pr<レフィーッラト>\ct<名詞 (水類)>\an<連用·主格·定>\ja<ウサギ>>
      \li<\sh<{чаб}>\pr<チャブ>\ct<小辞>\an<—>\ja<一方で>>
      \li<\sh<{заҕи̂л}>\pr<ザギール>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<眠る>>
      \li<\sh<{вечатту̂мар}>\pr<ヴェチャットゥーマル>\ct<動詞>\an<動形容詞·能動態·水類·連用·主格·不定>\ja<自信をもつ>>
      \li<\sh<{лоти̂лгозам}[.]>\pr<ロティールゴザム>\ct<名詞 (火類)>\an<連用·奪格·定>\ja<脚>>
    >
    \ja<
      一方で、ウサギは脚に自信があったので眠っていました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ко̂ддео}>\pr<コーッデウォ>\ct<名詞 (火類)>\an<連用·処格>\ja<～するとき>>
      \li<\sh<{са}>\pr<サ>\ct<小辞>\an<—>\ja<そして>>
      \li<\sh<{заххи̂с}>\pr<ザッヒース>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<到着する>>
      \li<\sh<{лесду̂кес}>\pr<レスドゥーケス>\ct<名詞 (水類)>\an<連用·与格·定>\ja<場所>>
      \li<\sh<{ледо̀ҕаллу̂зрес}[,]>\pr<レドーガッルーズレス>\ct<動詞>\an<動形容詞·受動態·水類·連用·与格·定>\ja<決める>>
      \li<\sh<{бахи̂зо}>\pr<バヒーゾ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<勝利する>>
      \li<\sh<{зи̂ллу̀к}>\pr<ズィーッルーク>\ct<副詞>\an<—>\ja<すでに>>
      \li<\sh<{лото̂ртаҕо}[.]>\pr<ロトールタゴ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<カメ>>
    >
    \ja<
      そして、ウサギが決められた場所に到着したときには、すでにカメが勝利していました。
    >
  >

