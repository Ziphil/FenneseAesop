\zml?|version="1.1"|;
\xml?|version="1.0",encoding="UTF-8"|;


\story|id="story-hare-turtoise"|<
  \title<
    \sh<Лефиллат и́ лотортаҕо>
    \ja<ウサギとカメ>
  >

  \sentence<
    \gloss<
      \li<\sh<{Аффѐ}>\pr<アッフェー>\ct<形容詞>\an<連用·水類·主格>\ja<とある>>
      \li<\sh<{ки̂шшари}>\pr<キーッシャリ>\ct<名詞 (水類)>\an<用言·主格·不定>\ja<日>>
      \li<\sh<{босси̂р}>\pr<ボッスィール>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<嘲笑う>>
      \li<\sh<{лефи̂ллат}>\pr<レフィーッラト>\ct<名詞>\an<連用·主格·定>\ja<ウサギ>>
      \li<\sh<{лото̂ртаҕос}>\pr<ロトールタゴス>\ct<名詞>\an<連用·与格·定>\ja<カメ>>
      \li<\sh<{ò}>\pr<オー>\ct<形容詞>\an<連用·火類·対格>\ja<彼の>>
      \li<\sh<{лоти̂лга}[.]>\pr<ロティールガ>\ct<名詞>\an<連用·対格·定>\ja<脚>>
    >
    \ja<
      ある日、ウサギがカメを脚について嘲笑いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ери̂шо}>\pr<エリーショ>\ct<動詞>\an<>\ja<言う>>
      \li<\sh<{лото̂ртаҕо}[.]>\pr<ロトールタゴ>\ct<名詞>\an<>\ja<カメ>>
    >
    \ja<
      カメは言いました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Но̂ч}[?]>\pr<ノーチ>\ct<間投詞>\an<—>\ja<何>>
    >
    \ja<
      何だって?
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Егту̂кко}>\pr<エグトゥーッコ>\ct<動詞>\an<能.現.三.定.火>\ja<確信する>>
      \li<\sh<{ко̂к}>\pr<コーク>\ct<名詞>\an<用.対>\ja<～ということ>>
      \li<\sh<{е̂ццо}>\pr<エーッツォ>\ct<名詞>\an<用.火.主>\ja<私>>
      \li<\sh<{екодфахи̂то}>\pr<エコドファヒート>\ct<動詞>\an<能.現.三.定.火>\ja<勝つ>>
      \li<\sh<{шес}>\pr<シェス>\ct<名詞>\an<用.水.主>\ja<君>>
      \li<\sh<{коччаси̂влут}[.]>\pr<コッチャスィーヴルト>\ct<動詞>\an<名.能.用.具>\ja<競走する>>
    >
    \ja<
      私は競走で君に勝つことを確信しているよ。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Оцери̂ш}>\pr<オチェリーシ>\ct<>\an<>\ja<答える>>
      \li<\sh<{га}>\pr<ガ>\ct<>\an<>\ja<一方で>>
      \li<\sh<{лефи̂ллат}[.]>\pr<レフィーッラト>\ct<>\an<>\ja<ウサギ>>
    >
    \ja<
      一方で、ウサギは答えました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂са}>\pr<トーサ>\ct<>\an<>\ja<それ>>
      \li<\sh<{чо̀к}>\pr<チョーク>\ct<>\an<>\ja<だけ>>
      \li<\sh<{тери̂шно}[.]>\pr<テリーシノ>\ct<>\an<>\ja<言う>>
    >
    \ja<
      そんなの口先だけだ。
    >
    \supl<
      直訳すると「それを言っているだけだ」になりますが、この表現は「行動が伴っていない」というニュアンスで使われることが多いので、ここでは「口先だけ」と訳してあります。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{И́та}>\pr<イタ>\ct<>\an<>\ja<では>>
      \li<\sh<{бо̀}>\pr<ボー>\ct<>\an<>\ja<～しよう>>
      \li<\sh<{бамекодгасу̂в}>\pr<バメコドガスーヴ>\ct<>\an<>\ja<勝負する>>
      \li<\sh<{аццани̂лос}[.]>\pr<アッツァニーロス>\ct<>\an<>\ja<はっきりさせる>>
    >
    \ja<
      では、はっきりさせるために勝負しよう。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ашну̂лез}>\pr<アシヌーレズ>\ct<>\an<>\ja<するのが良い>>
      \li<\sh<{ку̂к}>\pr<クーク>\ct<>\an<>\ja<～ということ>>
      \li<\sh<{не̂с}>\pr<ネース>\ct<>\an<>\ja<誰>>
      \li<\sh<{ҕаллу̂з}>\pr<ガッルーズ>\ct<>\an<>\ja<決める>>
      \li<\sh<{лесду̂ка}>\pr<レスドゥーカ>\ct<>\an<>\ja<場所>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<と>>
      \li<\sh<{ложи̂кеа}>\pr<ロジーケヤ>\ct<>\an<>\ja<時間>>
      \li<\sh<{и́}>\pr<イ>\ct<>\an<>\ja<と>>
      \li<\sh<{фезассу̂б}[?]>\pr<フェザッスーブ>\ct<>\an<>\ja<審判する>>
    >
    \ja<
      誰が場所と時間を決めて審判するのが良いだろうか?
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{И́с’}>\pr<イス>\ct<>\an<>\ja<すると>>
      \li<\sh<{оцери̂шо}[.]>\pr<オツェリーショ>\ct<>\an<>\ja<答える>>
    >
    \ja<
      すると、カメは答えました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лосо̂рро}[.]>\pr<ロソーッロ>\ct<>\an<>\ja<キツネ>>
    >
    \ja<
      キツネにしよう。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Е̂ко}>\pr<エーコ>\ct<>\an<>\ja<である>>
      \li<\sh<{маг}>\pr<マグ>\ct<>\an<>\ja<だから>>
      \li<\sh<{веки̂ффу}>\pr<ヴェキーッフ>\ct<>\an<>\ja<正直な>>
      \li<\sh<{и́бал}>\pr<イバル>\ct<>\an<>\ja<その上>>
      \li<\sh<{аззи̂ӈо}[.]>\pr<アッジーゴ>\ct<>\an<>\ja<賢明な>>
    >
    \ja<
      正直な上に賢明だから。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лосо̂рро}>\pr<ロソーッロ>\ct<>\an<>\ja<キツネ>>
      \li<\sh<{са}>\pr<サ>\ct<>\an<>\ja<そして>>
      \li<\sh<{ҕаллу̂зо}>\pr<ガッルーゾ>\ct<>\an<>\ja<決める>>
      \li<\sh<{ко̂ддa}>\pr<コーッダ>\ct<>\an<>\ja<時間>>
      \li<\sh<{цану̂т}>\pr<ツァヌート>\ct<>\an<>\ja<始める>>
      \li<\sh<{у}>\pr<ウ>\ct<>\an<>\ja<そのとき>>
      \li<\sh<{локоччаси̂вла}[.]>\pr<ロコッチャスィーヴラ>\ct<>\an<>\ja<競走する>>
    >
    \ja<
      キツネは競走を始める時間を決めました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ко̂ддео}>\pr<コーッデウォ>\ct<>\an<>\ja<～するとき>>
      \li<\sh<{сами̂мо}>\pr<サミーモ>\ct<>\an<>\ja<来る>>
      \li<\sh<{ложи̂кео}[,]>\pr<ロジーケオ>\ct<>\an<>\ja<時間>>
      \li<\sh<{лото̂ртаҕо}>\pr<ロトールタゴ>\ct<>\an<>\ja<カメ>>
      \li<\sh<{цану̂то}>\pr<ツァヌート>\ct<>\an<>\ja<始める>>
      \li<\sh<{ажжа}>\pr<アッジャ>\ct<>\an<>\ja<～しない>>
      \li<\sh<{зами̂вро}>\pr<ザミーヴロ>\ct<>\an<>\ja<遅れる>>
      \li<\sh<{саву̂лла}[.]>\pr<サヴーッラ>\ct<>\an<>\ja<進む>>
    >
    \ja<
      その時間が来たとき、カメは遅れることなく進み始めました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лефи̂ллат}>\pr<レフィーッラト>\ct<>\an<>\ja<ウサギ>>
      \li<\sh<{чаб}>\pr<チャブ>\ct<>\an<>\ja<一方で>>
      \li<\sh<{заҕи̂л}>\pr<ザギール>\ct<>\an<>\ja<眠る>>
      \li<\sh<{вечатту̂мар}>\pr<ヴェチャットゥーマル>\ct<>\an<>\ja<自信をもつ>>
      \li<\sh<{лоти̂лгозам}[.]>\pr<ロティールゴザム>\ct<>\an<>\ja<脚>>
    >
    \ja<
      一方で、ウサギは脚に自信があったので眠っていました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Ко̂ддео}>\pr<コーッデウォ>\ct<>\an<>\ja<～するとき>>
      \li<\sh<{са}>\pr<サ>\ct<>\an<>\ja<そして>>
      \li<\sh<{заххи̂с}>\pr<ザッヒース>\ct<>\an<>\ja<到着する>>
      \li<\sh<{лесду̂кес}>\pr<レスドゥーケス>\ct<>\an<>\ja<場所>>
      \li<\sh<{ледо̀ҕаллу̂зрес}[,]>\pr<レドーガッルーズレス>\ct<>\an<>\ja<決める>>
      \li<\sh<{бахи̂зо}>\pr<バヒーゾ>\ct<>\an<>\ja<勝利する>>
      \li<\sh<{зи̂ллу̀к}>\pr<ズィーッルーク>\ct<>\an<>\ja<すでに>>
      \li<\sh<{лото̂ртаҕо}[.]>\pr<ロトールタゴ>\ct<>\an<>\ja<カメ>>
    >
    \ja<
      そして、ウサギが決められた場所に到着したときには、すでにカメが勝利していました。
    >
  >

>