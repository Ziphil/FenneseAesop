\zml?|version="1.1"|;
\xml?|version="1.0",encoding="UTF-8"|;


\story|id="story-north-wind-sun"|<
  \title<
    \sh<Леҕ\d|t="c"|<у>зас \d|t="a"|<и> лок\d|t="c"|<у>шро>
    \ja<北風と太陽>
  >

  \sentence<
    \gloss<
      \li<\sh<{Леҕу̂зас}>\pr<レグーザス>\ct<名詞 (水類)>\an<連用·主格·定>\ja<北風>>
      \li<\sh<{кодкаху̂зар}>\pr<コドカフーズ>\ct<動詞>\an<動形容詞·能動態·水類·連用·主格·不定>\ja<張り合う>>
      \li<\sh<{локу̂шрос}>\pr<ロクーシュロス>\ct<名詞 (火類)>\an<連用·与格·定>\ja<太陽>>
      \li<\sh<{ери̂ш}[.]>\pr<エリーシャル>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<言う>>
    >
    \ja<
      北風が太陽と張り合いながら言いました。 
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Анне̂с}>\pr<アンネース>\ct<名詞>\an<水類·連用·主格>\ja<誰>>
      \li<\sh<{вос}>\pr<ヴォス>\ct<前置辞>\an<—>\ja<～のうち>>
      \li<\sh<{бе̂ммеве}>\pr<ベーンメヴェ>\ct<名詞>\an<水類·連体·処格>\ja<私たち>>
      \li<\sh<{заду̂н}>\pr<ザドゥーン>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<できる>>
      \li<\sh<{сау̂кла}>\pr<サウークラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<させる>>
      \li<\sh<{хѐ}>\pr<ヘー>\ct<形容詞>\an<前置·水類>\ja<あの>>
      \li<\sh<{лересги̂ццала}>\pr<レレスギーッツァラ>\ct<名詞>\an<水類·連用·対格·定>\ja<旅人>>
      \li<\sh<{насожу̂тра}>\pr<ナソジュートラ>\ct<動詞>\an<動形容詞·能動態·水類·連用·対格·不定>\ja<脱ぐ>>
      \li<\sh<{ловгу̂зма}[?]>\pr<ロヴグーズマ>\ct<名詞 (火類)>\an<連用·対格·定>\ja<コート>>
    >
    \ja<
      私たちのうちどちらが、あの旅人にコートを脱がせることができるだろうか?
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Леҕу̂зас}>\pr<レグーザス>\ct<名詞 (水類)>\an<連用·主格·定>\ja<北風>>
      \li<\sh<{цу̂тар}>\pr<ツータル>\ct<動詞>\an<動形容詞·能動態·水類·連用·主格·不定>\ja<取る>>
      \li<\sh<{леци̂нта}>\pr<レチーンタ>\ct<名詞 (水類)>\an<連用·対格·定>\ja<最初>>
      \li<\sh<{аббати̂ч}>\pr<アッバティーチュ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<吹きつける>>
      \li<\sh<{гу̂сбут}>\pr<グースブト>\ct<名詞 (火類)>\an<連用·具格·不定>\ja<力>>
      \li<\sh<{ловгу̂зма}>\pr<ロヴグーズマ>\ct<名詞 (火類)>\an<連用·対格·定>\ja<コート>>
      \li<\sh<{лабу̂ссар}>\pr<ラブーッサル>\ct<動詞>\an<動形容詞·能動態·水類·連用·主格·不定>\ja<期待する>>
      \li<\sh<{кодагу̂нла}>\pr<コダグーンラ>\ct<動詞>\an<動名詞·能動態·連用·対格·不定>\ja<奪い取る>>
      \li<\sh<{ех}[.]>\pr<エフ>\ct<名詞>\an<水類·連用·対格>\ja<それ>>
    >
    \ja<
      北風は、先陣を切って、コートを奪い取ることを期待しながら、力ずくでコートを吹きつけました。
    >
    \supl<
      日本語訳にある「先陣を切って」に相当する表現は {цу̂тар леци̂нта} の部分です。
      これは直訳すると「最初を取って」となります。
      この表現は、複数の人が順番に何かを行うというシチュエーションにおいて最初に行うことを表す際に使われます。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Лересги̂ццал}>\pr<レレスギーッツァル>\ct<名詞 (水類)>\an<連用·主格·定>\ja<旅人>>
      \li<\sh<{ҕа}>\pr<ガ>\ct<小辞>\an<—>\ja<しかし>>
      \li<\sh<{вечву̂с}[,]>\pr<ヴェチュヴース>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<凍える>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{цае̂тар}>\pr<ツァイェータル>\ct<名詞>\an<動形容詞·能動態·水類·連用·主格·不定>\ja<掴む>>
      \li<\sh<{би̂всѐ}>\pr<ビーヴセー>\ct<形容詞>\an<前置·水類>\ja<両方の>>
      \li<\sh<{лецу̂тот}>\pr<レツートト>\ct<名詞 (水類)>\an<連用·具格·定>\ja<手>>
      \li<\sh<{ловгу̂зма}>\pr<ロヴグーズマ>\ct<名詞 (火類)>\an<連用·対格·定>\ja<コート>>
      \li<\sh<{сеззу̂}>\pr<セッズー>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<隠れる>>
      \li<\sh<{ве}>\pr<ヴェ>\ct<前置辞>\an<—>\ja<～の中>>
      \li<\sh<{зу̂аӈос}>\pr<ズーワゴス>\ct<名詞 (火類)>\an<連用·与格·不定>\ja<穴>>
      \li<\sh<{ди̂лҕов}[.]>\pr<ディールゴヴ>\ct<名詞 (火類)>\an<連体·主格·不定>\ja<岩>>
    >
    \ja<
      しかし、旅人は凍えて、両手でコートを掴みながら岩穴の中へ隠れてしまいました。 
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Локу̂шро}>\pr<ロクーシュロ>\ct<名詞 (火類)>\an<連用·主格·定>\ja<太陽>>
      \li<\sh<{чаб}>\pr<チャブ>\ct<小辞>\an<—>\ja<一方で>>
      \li<\sh<{мали̂со}>\pr<マリーソ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<温める>>
      \li<\sh<{ех}>\pr<エフ>\ct<名詞>\an<水類·連用·対格>\ja<彼>>
      \li<\sh<{ци̂нту̀к}>\pr<ツィーントゥーク>\ct<副詞>\an<—>\ja<まず>>
      \li<\sh<{ацце̂тра}>\pr<アッツェートラ>\ct<動詞>\an<動形容詞·能動態·水類·連用·対格·不定>\ja<感じる>>
      \li<\sh<{жу̂валла}[.]>\pr<ジューヴァッラ>\ct<名詞 (水類)>\an<連用·対格·不定>\ja<寒さ>>
    >
    \ja<
      一方で太陽は、まず寒さを感じている旅人を温めました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{Сами̂ллут}>\pr<サミーッルト>\ct<動詞>\an<動名詞·能動態·連用·具格·不定>\ja<近づける>>
      \li<\sh<{ес}>\pr<エス>\ct<名詞>\an<水類·連用·与格>\ja<彼>>
      \li<\sh<{са}>\pr<サ>\ct<小辞>\an<—>\ja<そして>>
      \li<\sh<{лобоги̂жма}>\pr<ロボギージュマ>\ct<名詞 (火類)>\an<連用·対格·定>\ja<炎>>
      \li<\sh<{лезу̂сев}>\pr<レズーセヴ>\ct<名詞 (水類)>\an<連体·主格·定>\ja<自分>>
      \li<\sh<{сау̂ко}>\pr<サウーコ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<させる>>
      \li<\sh<{нажи̂ссара}>\pr<ナジーッサラ>\ct<動詞>\an<動形容詞·能動態·水類·連用·対格·不定>\ja<汗をかく>>
      \li<\sh<{ех}[,]>\pr<エフ>\ct<名詞>\an<水類·連用·対格>\ja<彼>>
      \li<\sh<{и́}>\pr<イ>\ct<連結辞>\an<—>\ja<そして>>
      \li<\sh<{оку̂зо}>\pr<オクーゾ>\ct<動詞>\an<能動態·現在時制·三人称·定·火類>\ja<仕向ける>>
      \li<\sh<{ех}>\pr<エフ>\ct<名詞>\an<水類·連用·対格>\ja<彼>>
      \li<\sh<{зах}>\pr<ザフ>\ct<小辞>\an<—>\ja<それによって>>
      \li<\sh<{насожу̂ллос}[.]>\pr<ナソジューッロス>\ct<動詞>\an<動名詞·能動態·連用·与格·不定>\ja<脱ぐ>>
    >
    \ja<
      そして、自分の炎を彼に近づけることで彼に汗をかかせ、彼が服を脱ぐよう仕向けました。
    >
  >

  \sentence<
    \gloss<
      \li<\sh<{То̂ччо̀ӈ}>\pr<トーッチョーン>\ct<副詞>\an<—>\ja<そのように>>
      \li<\sh<{кодбами̂ҕ}>\pr<コドバミーグ>\ct<動詞>\an<能動態·現在時制·三人称·定·水類>\ja<負ける>>
      \li<\sh<{леҕу̂зас}[.]>\pr<レグーザス>\ct<名詞 (水類)>\an<連用·主格·定>\ja<北風>>
    >
    \ja<
      このようにして、北風は負けてしまいました。
    >
  >

>